generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Asset {
  id           String  @id
  archived     Boolean @default(false)
  name         String
  type         String
  businessUnit String
  criticality  String

  /**
   * ISO 4217 currency of annualValue.
   * The "USD" default exists ONLY so the migration can backfill existing
   * development rows safely. The future API write layer must require an
   * explicit currency and must never rely on this default - new records
   * must not silently assume USD.
   */
  currency    String   @default("USD")
  annualValue Decimal  @db.Decimal(18, 2)
  status      String
  owner       String
  lastUpdated DateTime

  risks                Risk[]
  remediations         Remediation[]
  scenarios            Scenario[]
  insurancePolicyLinks InsurancePolicyAsset[]

  @@index([criticality])
  @@index([status])
  @@index([businessUnit])
}

model Risk {
  id         String  @id
  archived   Boolean @default(false)
  risk       String
  assetId    String
  category   String
  severity   String
  likelihood String

  /**
   * ISO 4217 currency of exposure. Defaults to the asset's operating
   * currency at write time in the application layer - the "USD" column
   * default is a migration backfill only, never an application assumption.
   */
  currency    String   @default("USD")
  exposure    Decimal  @db.Decimal(18, 2)
  status      String
  owner       String
  lastUpdated DateTime

  asset         Asset          @relation(fields: [assetId], references: [id])
  remediations  Remediation[]
  scenarios     Scenario[]
  auditFindings AuditFinding[]

  @@index([assetId])
  @@index([severity])
  @@index([status])
  @@index([category])
}

model Remediation {
  id       String   @id
  archived Boolean  @default(false)
  action   String
  riskId   String
  assetId  String
  category String
  priority String
  owner    String
  dueDate  DateTime
  status   String

  /**
   * ISO 4217 currency of estimatedCost and expectedReduction. Vendor
   * contracts may be issued in their own currency; the "USD" default is a
   * migration backfill only, never an application assumption.
   */
  currency          String  @default("USD")
  estimatedCost     Decimal @db.Decimal(18, 2)
  expectedReduction Decimal @db.Decimal(18, 2)

  risk          Risk           @relation(fields: [riskId], references: [id])
  asset         Asset          @relation(fields: [assetId], references: [id])
  auditFindings AuditFinding[]

  @@index([riskId])
  @@index([assetId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

model Scenario {
  id          String  @id
  archived    Boolean @default(false)
  name        String
  category    String
  description String
  riskId      String
  assetId     String
  severity    String
  probability String

  /**
   * ISO 4217 currency of estimatedImpact. Scenario modeling may be
   * performed in a group/base currency; the "USD" default is a migration
   * backfill only, never an application assumption.
   */
  currency        String  @default("USD")
  estimatedImpact Decimal @db.Decimal(18, 2)
  businessImpact  String
  status          String
  owner           String

  risk  Risk  @relation(fields: [riskId], references: [id])
  asset Asset @relation(fields: [assetId], references: [id])

  @@index([riskId])
  @@index([assetId])
  @@index([severity])
  @@index([status])
}

model InsurancePolicy {
  id           String  @id
  archived     Boolean @default(false)
  policyNumber String
  provider     String
  coverageType String

  /**
   * ISO 4217 policy currency set by the insurer contract. coverageLimit,
   * deductible, and premium are always denominated in this currency.
   * The "USD" default is a migration backfill only, never an application
   * assumption.
   */
  currency       String   @default("USD")
  coverageLimit  Decimal  @db.Decimal(18, 2)
  deductible     Decimal  @db.Decimal(18, 2)
  premium        Decimal  @db.Decimal(18, 2)
  expirationDate DateTime
  status         String
  notes          String?

  assetLinks InsurancePolicyAsset[]

  @@index([status])
  @@index([expirationDate])
  @@index([coverageType])
}

model InsurancePolicyAsset {
  policyId String
  assetId  String

  policy InsurancePolicy @relation(fields: [policyId], references: [id])
  asset  Asset           @relation(fields: [assetId], references: [id])

  @@id([policyId, assetId])
  @@index([assetId])
}

model Audit {
  id        String   @id
  archived  Boolean  @default(false)
  framework String
  scope     String
  status    String
  owner     String
  dueDate   DateTime

  findings AuditFinding[]

  @@index([status])
  @@index([framework])
  @@index([dueDate])
}

model AuditFinding {
  id            String   @id
  auditId       String
  riskId        String?
  remediationId String?
  description   String
  severity      String
  status        String
  owner         String
  dueDate       DateTime

  audit       Audit        @relation(fields: [auditId], references: [id])
  risk        Risk?        @relation(fields: [riskId], references: [id])
  remediation Remediation? @relation(fields: [remediationId], references: [id])

  @@index([auditId])
  @@index([riskId])
  @@index([remediationId])
  @@index([severity])
  @@index([status])
  @@index([dueDate])
}

model Report {
  id          String   @id
  name        String
  type        String
  period      String
  status      String
  generatedAt DateTime
  owner       String

  @@index([status])
  @@index([type])
  @@index([generatedAt])
}
