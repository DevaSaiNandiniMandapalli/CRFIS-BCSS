# CRFIS backend environment (copy to .env — never commit .env itself)

# PostgreSQL connection for the development database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/crfis"

# Fastify server bind configuration (defaults: 3000 / 127.0.0.1).
PORT=3000
HOST=127.0.0.1

# Log level for the API (pino levels).
LOG_LEVEL=info

# Vite dev-proxy target override when the API runs on a non-default port.
API_PORT=3000
